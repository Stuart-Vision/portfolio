# Contact form (EmailJS) — copy this file to .env.local and fill in your own keys.
# Sign up free at https://www.emailjs.com/, create a service + template, then:
#   Email Services  -> Service ID
#   Email Templates -> Template ID   (template must use {{name}}, {{email}}, {{message}})
#   Account -> API Keys -> Public Key
#
# Without these the site still runs; only the contact form's Send button will fail.

NEXT_PUBLIC_SERVICE_ID=your_service_id
NEXT_PUBLIC_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_USER_ID=your_public_key
